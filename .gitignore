# secrets — never commit
.env
.env.*
credentials.env

# dependencies & builds
node_modules/
dist/
*.tsbuildinfo
__pycache__/
*.pyc
*.pyo

# runtime data (SQLite lives on Railway volume /data in production)
data/
*.db
*.db-journal
*.db-wal

# sandbox platform scaffolding (untracked by design — see ADR-002).
# ADR-008 exception: postcss.config.mjs and public/ ARE tracked — the visual
# application's build requires them (product code, not environment scaffolding).
Caddyfile
components.json
tailwind.config.ts
eslint.config.mjs
examples/
mini-services/
.zscripts/
.next/
next-env.d.ts
skills/
upload/
download/
tool-results/
agent-ctx/
*.log
# Stage 2.3 (F-2.3-02) durability exception: the two evidence generation logs
# are REGISTERED artifacts (docs/stage2/evidence/SHA256SUMS) — the *.log rule
# silently made them non-durable, which broke evidence integrity after an
# environment recycle (validator honestly failed 51/53). Negated here so the
# registered evidence is committable. Scope is exactly the evidence directory.
!docs/stage2/evidence/*.log

# OS / editor
.DS_Store
Thumbs.db
